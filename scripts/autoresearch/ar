#!/usr/bin/env bash
# ar: local driver for kernel autoresearch campaigns on Quokka GPU kernels.
# Builds and times on moth's MI210 (gfx90a). See README.md (humans) and
# program.md (the agent).
#
#   ar init TAG --problem NAME --edit "PATH..." [--kernel REGEX] [--dim N]
#           [--check-args "ARGS"] [--time-args "ARGS"]
#                               worktree + branch autoresearch/TAG at HEAD
#   ar set KEY=VALUE...         change campaign settings (before the baseline)
#   ar setup                    configure + build the seed on moth, list kernels
#   ar kernels                  the seed's GPU kernels by total time (from setup)
#   ar eval "DESCRIPTION" [--pairs N] [--bar X] [--contended]
#           [--gpu-wait SECONDS]
#                               evaluate the worktree's HEAD against the best
#   ar resume RUN               reattach to an eval whose connection dropped
#   ar status                   results table, best run, deadline
#   ar deadline set-in MINUTES | set-at "YYYY-MM-DD HH:MM" | show | clear
#   ar target SPEEDUP | show | clear
#                               end the campaign once a kept run is SPEEDUP
#                               times faster than the baseline on the kernel
#
# TAG comes from `ar init`, then from $AR_TAG or the current branch name.
# Works with macOS bash 3.2.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
host=${AR_HOST:-moth}
remote_root=${AR_REMOTE_ROOT:-/mnt/data/bwibking/ar-quokka}
main=$(git -C "$here" rev-parse --show-toplevel) || exit 1
# A run with one of these statuses is discarded: its commit is tagged and the
# worktree is reset to the best commit.
DISCARD_STATUSES=" discard identical incorrect hang build-fail launch-mismatch "
# Settings `ar set` may change before the baseline.
SETTABLE=" PROBLEM DIM KERNEL_RE EDIT_PATHS CHECK_ARGS TIME_ARGS CMAKE_ARGS RUN_PREFIX "

die() { echo "ar: $*" >&2; exit 1; }
# One plain `ssh moth` connection per command (moth's firewall dislikes bursts).
ssh_moth() {
  ssh -o WarnWeakCrypto=no -o ServerAliveInterval=30 -o ServerAliveCountMax=10 "$host" "$@"
}
kv() {  # kv KEY LINE : value of KEY=VALUE in a RESULT line, or "-"
  local v
  v=$(sed -nE "s/.* $1=([^ ]*).*/\1/p" <<<"$2" | head -1)
  echo "${v:--}"
}
q() { printf '%q' "$1"; }  # shell-quote one word for campaign.env and ssh

resolve_tag() {
  tag=${AR_TAG:-}
  if [[ -z $tag ]]; then
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    [[ $branch == autoresearch/* ]] && tag=${branch#autoresearch/}
  fi
  [[ -n $tag ]] || die "no campaign: run inside the campaign worktree or set AR_TAG"
  C=$main/.notes/autoresearch/$tag
  [[ -f $C/campaign.env ]] || die "no campaign $tag at $C"
  # shellcheck disable=SC1091
  source "$C/campaign.env"
  BEST_RUN=none; BEST_SHA=$SEED
  # shellcheck disable=SC1091
  [[ -f $C/best.env ]] && source "$C/best.env"
}

set_env() {  # set_env KEY VALUE : replace KEY in campaign.env
  grep -v "^$1=" "$C/campaign.env" > "$C/campaign.env.new"
  echo "$1=$(q "$2")" >> "$C/campaign.env.new"
  mv "$C/campaign.env.new" "$C/campaign.env"
}

cmd_init() {
  tag=${1:?usage: ar init TAG --problem NAME --edit \"PATH...\" [options]}; shift
  [[ $tag =~ ^[A-Za-z0-9._-]+$ ]] || die "TAG may use letters, digits, . _ -"
  local problem="" edit="" kernel="" dim=3 check="" timeargs=""
  while (($#)); do
    case $1 in
      --problem) problem=$2; shift ;;
      --edit) edit=$2; shift ;;
      --kernel) kernel=$2; shift ;;
      --dim) dim=$2; shift ;;
      --check-args) check=$2; shift ;;
      --time-args) timeargs=$2; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  [[ -n $problem && -n $edit ]] || die "--problem and --edit are required"
  [[ $dim =~ ^[123]$ ]] || die "--dim must be 1, 2 or 3"
  local p
  for p in $edit; do
    [[ -e $main/$p ]] || die "--edit path $p does not exist in $main"
    [[ $p != extern* ]] || die "--edit may not include submodules ($p)"
    # The problem's own test and inputs judge correctness, so they stay fixed.
    [[ $p != src/problems/$problem* && $p != inputs* && $p != src/problems && $p != src && $p != . ]] ||
      die "--edit may not include the problem's test or inputs ($p)"
  done
  # Run directories sit one level below the source root, like ctest's tests/.
  [[ -n $check ]] || check="../inputs/$problem.toml"
  [[ -n $timeargs ]] || timeargs=$check
  C=$main/.notes/autoresearch/$tag
  [[ -e $C ]] && die "campaign $tag already exists at $C"
  local exclude base wt
  exclude=$(cd "$main" && cd "$(git rev-parse --git-common-dir)" && pwd)/info/exclude
  grep -qx '/.notes/' "$exclude" 2>/dev/null || echo '/.notes/' >> "$exclude"
  base=$(git -C "$main" rev-parse HEAD)
  wt=${AR_WORKTREE:-$(cd "$main/.." && pwd)/quokka-ar-$tag}
  git -C "$main" worktree add --quiet -b "autoresearch/$tag" "$wt" "$base" || die "worktree add failed"
  echo "fetching submodules into $wt (setup ships them to moth)"
  git -C "$wt" submodule update --init --recursive --quiet || die "submodule update failed in $wt"
  mkdir -p "$C/runs"
  {
    echo "TAG=$tag"
    echo "BASE=$base"
    echo "SEED=$base"
    echo "WORKTREE=$(q "$wt")"
    echo "PROBLEM=$(q "$problem")"
    echo "DIM=$dim"
    echo "KERNEL_RE=$(q "$kernel")"
    echo "EDIT_PATHS=$(q "$edit")"
    echo "CHECK_ARGS=$(q "$check")"
    echo "TIME_ARGS=$(q "$timeargs")"
    echo "CMAKE_ARGS=''"
    echo "RUN_PREFIX=''"
  } > "$C/campaign.env"
  printf 'run\tcommit\tstatus\tspeedup\ttotal_speedup\tcand_ms\tbest_ms\tvs_baseline\tlaunches\tvgpr\tsgpr\tscratch\tminutes\tdescription\n' > "$C/results.tsv"
  printf '# Campaign %s notes\n\nHypotheses, observations and dead ends, newest last.\n' "$tag" > "$C/notes.md"
  echo "campaign $tag: worktree $wt, state $C"
  echo "next: cd $wt && $here/ar setup"
}

cmd_set() {
  resolve_tag
  [[ ! -f $C/best.env ]] || die "the baseline is recorded; settings are frozen (start a new campaign)"
  (($#)) || die "set KEY=VALUE..., KEY one of:$SETTABLE"
  local arg key rebuild=0
  for arg in "$@"; do
    key=${arg%%=*}
    [[ $arg == *=* && $SETTABLE == *" $key "* ]] || die "set KEY=VALUE, KEY one of:$SETTABLE"
    set_env "$key" "${arg#*=}"
    echo "$key=${arg#*=}"
    [[ $key == PROBLEM || $key == DIM || $key == CMAKE_ARGS ]] && rebuild=1
  done
  ((rebuild)) && echo "build settings changed: re-run ar setup"
  return 0
}

# The settings remote.sh needs, as shell-quoted words for the ssh command.
remote_settings() {
  printf '%s ' "$(q "$PROBLEM")" "$(q "$DIM")" "$(q "$KERNEL_RE")" "$(q "$EDIT_PATHS")" \
    "$(q "$CHECK_ARGS")" "$(q "$TIME_ARGS")" "$(q "$CMAKE_ARGS")" "$(q "$RUN_PREFIX")"
}

cmd_setup() {
  resolve_tag
  local stage
  stage=$(mktemp -d "${TMPDIR:-/tmp}/ar-setup.XXXXXX")
  mkdir -p "$stage/bin"
  cp "$here/remote.sh" "$here/analyze.py" "$stage/bin/"
  if [[ ${1:-} == --bin-only ]]; then
    COPYFILE_DISABLE=1 tar --no-xattrs -C "$stage" -cf - bin |
      ssh_moth "mkdir -p $remote_root/$TAG && tar -xf - -C $remote_root/$TAG && echo bin updated"
    rm -rf "$stage"; return
  fi
  # The seed tree, submodules included: git archive skips submodules, so each
  # one is archived from the campaign worktree at the commit it has checked out.
  echo "packing ${SEED:0:10} with submodules"
  mkdir -p "$stage/src"
  git -C "$WORKTREE" archive "$SEED" | tar -xf - -C "$stage/src" || die "git archive failed"
  git -C "$WORKTREE" submodule foreach --quiet --recursive \
    'git archive HEAD | tar -xf - -C "'"$stage"'/src/$displaypath"' || die "submodule archive failed"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$stage/src" -czf "$stage/src.tar.gz" . || die "tar failed"
  rm -rf "$stage/src"
  echo "setup $TAG on $host: $PROBLEM (${DIM}D) from ${SEED:0:10} (a full HIP build takes a while)"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$stage" -cf - bin src.tar.gz |
    ssh_moth "mkdir -p $remote_root/$TAG && tar -xf - -C $remote_root/$TAG && bash $remote_root/$TAG/bin/remote.sh setup-start $TAG $SEED $(remote_settings)" 2>&1 |
    tee "$C/setup.log"
  rm -rf "$stage"
  grep -q '^SETUP ok' "$C/setup.log" || die "setup failed; see $C/setup.log"
  sed -n '/^KERNELS$/,/^END KERNELS$/p' "$C/setup.log" | sed '1d;$d' > "$C/kernels.txt"
  [[ -n $KERNEL_RE ]] || echo "no kernel chosen yet: pick a regex from ar kernels, then ar set KERNEL_RE='...'"
  echo "setup ok. next: ar eval \"baseline\" (from the worktree, at the seed commit)"
}

cmd_kernels() {
  resolve_tag
  [[ -f $C/kernels.txt ]] || die "no kernel list; run ar setup"
  cat "$C/kernels.txt"
  [[ -n $KERNEL_RE ]] && echo "KERNEL_RE=$KERNEL_RE"
  return 0
}

clock_line() {  # print local time and minutes left, so agents never estimate the clock
  local now end
  now=$(date +%s)
  if [[ -f $C/deadline ]]; then
    end=$(cat "$C/deadline")
    echo "ar: clock $(date -r "$now" '+%F %H:%M %Z'); deadline $(date -r "$end" '+%H:%M %Z'), $(( (end - now) / 60 )) min left"
  else
    echo "ar: clock $(date -r "$now" '+%F %H:%M %Z'); no deadline"
  fi
}

deadline_check() {  # refuse to start an eval after the target or deadline
  if [[ -f $C/complete ]]; then
    echo "ar: $(cat "$C/complete"). Campaign over." >&2
    exit 3
  fi
  [[ -f $C/deadline ]] || return 0
  local end now need
  end=$(cat "$C/deadline"); now=$(date +%s)
  need=$(awk -F'\t' 'NR > 1 && $13 ~ /^[0-9]+$/ {print $13}' "$C/results.tsv" | tail -3 | sort -n |
    awk '{a[NR] = $1} END {print (NR ? a[int((NR + 1) / 2)] : 10)}')
  if (( now + need * 60 > end )); then
    echo "ar: deadline $(date -r "$end" '+%F %T') leaves $(( (end - now) / 60 )) min; an eval needs ~$need min. Campaign over." >&2
    exit 3
  fi
}

record() {  # record RUN : unpack the bundle, log the row, apply the verdict
  local run=$1 d=$C/runs/$1 res status sha desc vs="-"
  sha=$(sed -n 's/^sha=//p' "$d/meta"); desc=$(sed -n 's/^desc=//p' "$d/meta")
  [[ -s $d/bundle.tgz ]] && tar xzf "$d/bundle.tgz" -C "$d" 2>/dev/null
  if [[ ! -f $d/result.txt ]]; then
    echo "ar: no result for $run (connection lost?). Reattach with: ar resume $run" >&2
    exit 4
  fi
  res=$(cat "$d/result.txt")
  status=$(kv status "$res")
  if [[ -n ${BASELINE_MS:-} && $(kv cand_ms "$res") != - ]]; then
    vs=$(awk -v b="$BASELINE_MS" -v c="$(kv cand_ms "$res")" 'BEGIN {printf "%.4f", b / c}')
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$run" "${sha:0:10}" "$status" \
    "$(kv median_speedup "$res")" "$(kv total_speedup "$res")" "$(kv cand_ms "$res")" \
    "$(kv best_ms "$res")" "$vs" "$(kv launches "$res")" "$(kv vgpr "$res")" "$(kv sgpr "$res")" \
    "$(kv scratch "$res")" "$(kv minutes "$res")" "$desc" >> "$C/results.tsv"
  echo
  echo "$res"
  case $status in
    baseline|keep)
      printf 'BEST_RUN=%s\nBEST_SHA=%s\n' "$run" "$sha" > "$C/best.env"
      if [[ $status == baseline ]]; then
        # Default acceptance bar: twice the median A/A deviation, never below
        # 2%. The median ignores the occasional run in a slow timing mode.
        local bar
        bar=$(awk -v s="$(kv aa_median_dev "$res")" 'BEGIN {b = 1 + 2 * s; if (b < 1.02) b = 1.02; printf "%.3f", b}')
        set_env BAR "$bar"
        set_env BASELINE_MS "$(kv cand_ms "$res")"
        echo "VERDICT baseline: best is now $run; median A/A deviation $(kv aa_median_dev "$res") sets the bar to $bar"
      else
        echo "VERDICT keep: best is now $run (${sha:0:10}), ${vs}x the baseline"
      fi
      if [[ -n ${TARGET_SPEEDUP:-} && $vs != - ]] && awk -v r="$vs" -v t="$TARGET_SPEEDUP" 'BEGIN {exit !(r + 0 >= t + 0)}'; then
        echo "target reached by $run: ${vs}x the baseline >= $TARGET_SPEEDUP" > "$C/complete"
        echo "TARGET REACHED: $(cat "$C/complete"). Campaign over."
      fi ;;
    *)
      if [[ $DISCARD_STATUSES == *" $status "* && $BEST_RUN != none ]]; then
        git -C "$WORKTREE" tag -f "ar/$TAG/$run-$status" "$sha" > /dev/null
        git -C "$WORKTREE" reset -q --hard "$BEST_SHA"
        echo "VERDICT $status: commit kept as tag ar/$TAG/$run-$status; worktree reset to best $BEST_RUN (${BEST_SHA:0:10})"
      else
        echo "VERDICT $status: nothing changed. Fix the cause or re-run ar eval on the same commit."
      fi ;;
  esac
}

outside_edit_paths() {  # outside_edit_paths SHA : changed paths outside EDIT_PATHS
  local f p ok
  git -C "$WORKTREE" diff --name-only "$SEED" "$1" | while read -r f; do
    ok=0
    for p in $EDIT_PATHS; do
      [[ $f == "$p" || $f == "${p%/}/"* ]] && ok=1
    done
    ((ok)) || echo "$f"
  done
}

cmd_eval() {
  resolve_tag
  local desc=${1:?usage: ar eval \"DESCRIPTION\" [options]}; shift
  local pairs=5 bar=${BAR:-1.02} contended=0 gpu_wait=1800
  while (($#)); do
    case $1 in
      --pairs) pairs=$2; shift ;;
      --bar) bar=$2; shift ;;
      --contended) contended=1 ;;
      --gpu-wait) gpu_wait=$2; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  [[ $pairs =~ ^[1-9][0-9]?$ && $gpu_wait =~ ^[0-9]+$ ]] || die "bad option value"
  [[ -n $KERNEL_RE ]] || die "no kernel chosen: see ar kernels, then ar set KERNEL_RE='...'"
  clock_line
  deadline_check
  cd "$WORKTREE" || die "worktree $WORKTREE missing"
  [[ $(git rev-parse --abbrev-ref HEAD) == "autoresearch/$TAG" ]] || die "worktree is not on autoresearch/$TAG"
  # shellcheck disable=SC2086
  [[ -z $(git status --porcelain --untracked-files=no --ignore-submodules=all) && -z $(git status --porcelain -- $EDIT_PATHS) ]] ||
    die "commit (or discard) your changes first; ar eval measures HEAD"
  local sha outside
  sha=$(git rev-parse HEAD)
  git merge-base --is-ancestor "$SEED" "$sha" || die "HEAD does not descend from the seed commit"
  outside=$(outside_edit_paths "$sha")
  [[ -z $outside ]] || die "only $EDIT_PATHS may change; this commit also changes:"$'\n'"$outside"
  if [[ $BEST_RUN == none ]]; then
    [[ $sha == "$SEED" ]] || die "no baseline yet: evaluate the seed commit first (ar eval \"baseline\")"
  else
    [[ $sha != "$BEST_SHA" ]] || die "HEAD is the current best; commit a change first"
  fi
  mkdir "$C/lock" 2>/dev/null || die "another eval holds $C/lock (remove it if that eval is dead)"
  trap 'rmdir "$C/lock" 2>/dev/null; clock_line' EXIT
  local n run d
  n=$(($(wc -l < "$C/results.tsv") - 1))
  run=$(printf 'e%03d' "$n")
  while [[ -e $C/runs/$run ]]; do n=$((n + 1)); run=$(printf 'e%03d' "$n"); done
  d=$C/runs/$run; mkdir -p "$d"
  printf 'sha=%s\ndesc=%s\nbest=%s\nstarted=%s\n' "$sha" "$(printf '%s' "$desc" | tr '\t\n' '  ')" "$BEST_RUN" "$(date '+%F %T')" > "$d/meta"
  echo "eval $run ${sha:0:10} vs ${BEST_RUN} on $host (pairs=$pairs bar=$bar): $desc"
  # The editable paths only; moth overlays them on its copy of the seed tree.
  # shellcheck disable=SC2086
  { git archive --format=tar.gz "$sha" -- $EDIT_PATHS |
      ssh_moth "bash $remote_root/$TAG/bin/remote.sh eval-start $TAG $run $BEST_RUN $pairs $bar $contended $gpu_wait $(remote_settings)" \
      > "$d/bundle.tgz"; } 2>&1 | tee "$d/eval.log"
  record "$run"
}

cmd_resume() {
  resolve_tag
  local run=${1:?usage: ar resume RUN} d
  d=$C/runs/$run
  [[ -f $d/meta ]] || die "no run $run"
  grep -q "^$run"$'\t' "$C/results.tsv" && die "$run is already recorded"
  mkdir "$C/lock" 2>/dev/null || die "another eval holds $C/lock"
  trap 'rmdir "$C/lock" 2>/dev/null; clock_line' EXIT
  { ssh_moth "bash $remote_root/$TAG/bin/remote.sh resume $TAG $run" > "$d/bundle.tgz"; } 2>&1 | tee -a "$d/eval.log"
  record "$run"
}

cmd_status() {
  resolve_tag
  column -t -s $'\t' "$C/results.tsv"
  echo
  echo "campaign $TAG  problem $PROBLEM (${DIM}D)  worktree $WORKTREE  HEAD $(git -C "$WORKTREE" rev-parse --short=10 HEAD)"
  echo "kernel /${KERNEL_RE:-(not chosen)}/  editable: $EDIT_PATHS"
  echo "best $BEST_RUN (${BEST_SHA:0:10})  bar ${BAR:-1.02 (until baseline)}  baseline ${BASELINE_MS:--} ms"
  clock_line
  [[ -n ${TARGET_SPEEDUP:-} ]] && echo "target: kept run at least ${TARGET_SPEEDUP}x faster than the baseline on the kernel"
  [[ -f $C/complete ]] && echo "COMPLETE: $(cat "$C/complete")"
  echo "state: $C"
}

cmd_target() {
  resolve_tag
  case ${1:-show} in
    show) ;;
    clear) grep -v '^TARGET_SPEEDUP=' "$C/campaign.env" > "$C/campaign.env.new"; mv "$C/campaign.env.new" "$C/campaign.env"
           unset TARGET_SPEEDUP ;;
    *) [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "target SPEEDUP | show | clear"
       set_env TARGET_SPEEDUP "$1"; TARGET_SPEEDUP=$1 ;;
  esac
  echo "target: ${TARGET_SPEEDUP:-none}"
}

cmd_deadline() {
  resolve_tag
  case ${1:-show} in
    set-in) [[ ${2:-} =~ ^[0-9]+$ ]] || die "set-in MINUTES"; echo $(( $(date +%s) + $2 * 60 )) > "$C/deadline" ;;
    set-at) date -j -f '%Y-%m-%d %H:%M' "${2:-}" +%s > "$C/deadline.new" 2>/dev/null ||
              { rm -f "$C/deadline.new"; die "set-at \"YYYY-MM-DD HH:MM\""; }
            mv "$C/deadline.new" "$C/deadline" ;;
    clear) rm -f "$C/deadline"; echo "no deadline"; return ;;
    show) ;;
    *) die "deadline set-in MINUTES | set-at \"YYYY-MM-DD HH:MM\" | show | clear" ;;
  esac
  if [[ -f $C/deadline ]]; then
    echo "deadline $(date -r "$(cat "$C/deadline")" '+%F %T') ($(( ($(cat "$C/deadline") - $(date +%s)) / 60 )) min left)"
  else
    echo "no deadline"
  fi
}

# Sourcing defines the functions without running a command (for tests).
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
sub=${1:-}; shift || true
case $sub in
  init) cmd_init "$@" ;;
  set) cmd_set "$@" ;;
  setup) cmd_setup "$@" ;;
  kernels) cmd_kernels ;;
  eval) cmd_eval "$@" ;;
  resume) cmd_resume "$@" ;;
  status) cmd_status ;;
  deadline) cmd_deadline "$@" ;;
  target) cmd_target "$@" ;;
  *) sed -n '2,24p' "$0"; exit 2 ;;
esac
