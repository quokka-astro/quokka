#!/usr/bin/env bash

#SBATCH -A ast146
#SBATCH -J amrex_quokka
#SBATCH -o 64node_%x-%j.out
#SBATCH -t 00:10:00
#SBATCH -p batch
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=7
#SBATCH --gpus-per-task=1
#SBATCH --gpu-bind=closest
#SBATCH -N 64

. scripts/frontier.profile

# GPU-aware MPI
export MPICH_GPU_SUPPORT_ENABLED=1

srun build/src/problems/HydroBlast3D/test_hydro3d_blast tests/benchmark_unigrid_2048.toml
