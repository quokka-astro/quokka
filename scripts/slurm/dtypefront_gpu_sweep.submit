#!/bin/bash --login
#SBATCH --job-name=dtypefront_gpu
#SBATCH --output=%x-%j.out
#SBATCH --error=%x-%j.err
#SBATCH --time=00:20:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=h200:1
#SBATCH --gpu-bind=closest
#SBATCH --mem=64G

set -euo pipefail

ROOT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
INPUT_FILE="${ROOT_DIR}/inputs/DTypeFront_JAFF.toml"
LOG_DIR="${ROOT_DIR}/logs/dtypefront-${SLURM_JOB_ID:-manual}"
BUILD_DIR="${ROOT_DIR}/build/slurm-dtypefront-rosenbrock"
BUILD_JOBS="${SLURM_CPUS_PER_TASK:-16}"
# the Rosenbrock tableaus to time, one build of DTypeFront_JAFF each
TABLEAUS=(ROS2S Rodas3P Rodas4P Rodas5P)

mkdir -p "${LOG_DIR}"

run_case() {
	local exe="$1"
	local tag="$2"
	shift 2

	echo "=== $(date -Is) ${tag} ==="
	echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
	/usr/bin/time -p "${exe}" "${INPUT_FILE}" "$@" \
		> "${LOG_DIR}/${tag}.log" 2>&1
}

configure_build() {
	local tableau="$1"

	# Only DTypeFront_JAFF depends on the tableau, so after the first pass a reconfigure rebuilds just that target.
	cmake -S "${ROOT_DIR}" -B "${BUILD_DIR}" -DDTypeFront_JAFF_TABLEAU="${tableau}" -DAMReX_GPU_BACKEND=CUDA -DAMReX_CUDA_ARCH=9.0 -DAMReX_SPACEDIM=3 -DCMAKE_BUILD_TYPE=Release
	cmake --build "${BUILD_DIR}" --target DTypeFront_JAFF -j "${BUILD_JOBS}"
}

echo "Running on ${HOSTNAME}"
echo "Submit dir: ${ROOT_DIR}"
echo "Log dir: ${LOG_DIR}"
echo "Build jobs: ${BUILD_JOBS}"

for tableau in "${TABLEAUS[@]}"; do
	configure_build "${tableau}"
	run_case "${BUILD_DIR}/src/problems/DTypeFront_JAFF/DTypeFront_JAFF" "${tableau,,}"
done

echo "Done."
