#!/bin/bash --login
#SBATCH -A ast236
#SBATCH -J dtypefront_frontier
#SBATCH -o %x-%j.out
#SBATCH -e %x-%j.err
#SBATCH -t 00:30:00
#SBATCH -p batch
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=7
#SBATCH --gpus-per-task=1
#SBATCH --gpu-bind=closest

set -euo pipefail

ROOT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
INPUT_FILE="${ROOT_DIR}/inputs/DTypeFront_JAFF.toml"
LOG_DIR="${ROOT_DIR}/logs/dtypefront-frontier-${SLURM_JOB_ID:-manual}"
BUILD_DIR="${ROOT_DIR}/build/slurm-dtypefront-frontier-rosenbrock"
BUILD_JOBS="${SLURM_CPUS_PER_TASK:-7}"
# the Rosenbrock tableaus to time, one build of DTypeFront_JAFF each
TABLEAUS=(ROS2S Rodas3P Rodas4P Rodas5P)

. "${ROOT_DIR}/scripts/hpc_profiles/frontier.profile"

GPU_ARCH="${AMREX_AMD_ARCH:-gfx90a}"

mkdir -p "${LOG_DIR}"

run_case() {
	local exe="$1"
	local tag="$2"
	shift 2

	echo "=== $(date -Is) ${tag} ==="
	echo "ROCR_VISIBLE_DEVICES=${ROCR_VISIBLE_DEVICES:-unset}"
	echo "HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-unset}"
	/usr/bin/time -p srun -N 1 -n 1 --gpus-per-task=1 --gpu-bind=closest "${exe}" "${INPUT_FILE}" "$@" \
		> "${LOG_DIR}/${tag}.log" 2>&1
}

configure_build() {
	local tableau="$1"

	# Only DTypeFront_JAFF depends on the tableau, so after the first pass a reconfigure rebuilds just that target.
	cmake -S "${ROOT_DIR}" -B "${BUILD_DIR}" \
		-DCMAKE_BUILD_TYPE=Release \
		-DDTypeFront_JAFF_TABLEAU="${tableau}" \
		-DAMReX_GPU_BACKEND=HIP \
		-DAMReX_AMD_ARCH="${GPU_ARCH}" \
		-DAMReX_SPACEDIM=3
	cmake --build "${BUILD_DIR}" --target DTypeFront_JAFF -j "${BUILD_JOBS}"
}

echo "Running on ${HOSTNAME}"
echo "Submit dir: ${ROOT_DIR}"
echo "Log dir: ${LOG_DIR}"
echo "Build jobs: ${BUILD_JOBS}"
echo "AMReX AMD arch: ${GPU_ARCH}"

for tableau in "${TABLEAUS[@]}"; do
	configure_build "${tableau}"
	run_case "${BUILD_DIR}/src/problems/DTypeFront_JAFF/DTypeFront_JAFF" "${tableau,,}"
done

echo "Done."
