#!/usr/bin/env bash

#SBATCH -A ast236
#SBATCH -J quokka_openpmd_restart
#SBATCH -o openpmd_restart_%x-%j.out
#SBATCH -t 01:00:00
#SBATCH -p batch
#SBATCH -N 64

# At-scale openPMD checkpoint/restart test (HydroBlast3D with tracers).
#
#   1. reference: native AMReX checkpoints at steps K and 2K on all nodes
#   2. openpmd:   openPMD checkpoint at step K on all nodes
#   3. restarted: restart from the openPMD checkpoint on RESTART_NODES nodes
#                 (a different rank count), write a native checkpoint at 2K
#   4. control:   the same restart from the native checkpoint (CONTROL=1)
#   5. compare:   cell data and tracers at step 2K must match bit for bit
#
# Build first (on a login node), from the repository root:
#   quokka config -d 3d-hip --source scripts/hpc_profiles/frontier.profile --root . \
#     -DQUOKKA_OPENPMD=ON -DADIOS2_DIR=<adios2 prefix>/lib64/cmake/adios2
#   quokka build -d 3d-hip --source scripts/hpc_profiles/frontier.profile --root . HydroBlast3D
#   ninja -C build/3d-hip OpenPMDCheckpoint
#
# Submit from the repository root:
#   sbatch scripts/slurm/frontier-openpmd-restart.submit
#
# Overrides (environment variables, e.g. `sbatch --export=ALL,NCELL=4096 -N 512 ...`):
#   NCELL          cells per dimension (default 2048; 2048^3 fits 64 nodes)
#   CHK_STEP       K, the step of the checkpoint used for restart (default 10)
#   RESTART_NODES  nodes for the restarted runs (default: half the allocation)
#   CONTROL        1 to also restart from the native checkpoint (default 1)
#   BUILD_DIR      build directory (default build/3d-hip)
#   RUN_DIR        output directory on Orion (default under the project scratch)
#
# Each checkpoint is about 100 bytes per cell (cell data and tracers), so
# 2048^3 produces roughly 0.9 TB per checkpoint and about 4.5 TB in total.

QUOKKA_ROOT=${SLURM_SUBMIT_DIR:-$(pwd)}
cd "${QUOKKA_ROOT}" || exit 1
# Source before enabling strict mode: the module scripts reference unset variables.
# shellcheck source=/dev/null
. scripts/hpc_profiles/frontier.profile
set -euo pipefail
export OMP_NUM_THREADS=1

NCELL=${NCELL:-2048}
CHK_STEP=${CHK_STEP:-10}
FINAL_STEP=$((2 * CHK_STEP))
NODES=${SLURM_JOB_NUM_NODES}
RESTART_NODES=${RESTART_NODES:-$(((NODES + 1) / 2))}
CONTROL=${CONTROL:-1}
BUILD_DIR=$(realpath -m "${BUILD_DIR:-build/3d-hip}")
RUN_DIR=${RUN_DIR:-/lustre/orion/${proj}/scratch/${USER}/quokka-openpmd-restart/${SLURM_JOB_ID}}

SIM=${BUILD_DIR}/src/problems/HydroBlast3D/HydroBlast3D
COMPARE=${BUILD_DIR}/src/problems/ParticleSchema/OpenPMDCheckpoint
for exe in "${SIM}" "${COMPARE}"; do
	[[ -x ${exe} ]] || {
		echo "missing executable: ${exe}" >&2
		exit 1
	}
done
if ((RESTART_NODES < 1 || RESTART_NODES > NODES)); then
	echo "RESTART_NODES=${RESTART_NODES} must be between 1 and ${NODES}" >&2
	exit 1
fi

mkdir -p "${RUN_DIR}"
cd "${RUN_DIR}"

chk() { printf '%s%07d' "$1" "$2"; }

common=("${QUOKKA_ROOT}/inputs/HydroBlast3D.toml"
	"amr.n_cell=${NCELL} ${NCELL} ${NCELL}" amr.max_level=0 amr.max_grid_size=128 amr.blocking_factor=128
	do_tracers=1 plotfile_interval=-1 quokka.slice_z.int=-1 blast_problem.check_solution=0
	checkpoint_interval="${CHK_STEP}" max_timesteps="${FINAL_STEP}")

# Run one step of the test on the first $1 nodes; output goes to <label>.log.
run() {
	local label=$1 nodes=$2
	shift 2
	echo "=== ${label}: ${nodes} nodes, $((nodes * 8)) ranks"
	local start=${SECONDS}
	if ! srun -N "${nodes}" -n $((nodes * 8)) --ntasks-per-node=8 --cpus-per-task=7 --gpus-per-task=1 --gpu-bind=closest \
		"$@" >"${label}.log" 2>&1; then
		echo "${label} FAILED; see ${RUN_DIR}/${label}.log"
		tail -n 30 "${label}.log"
		exit 1
	fi
	echo "${label} finished in $((SECONDS - start)) s"
}

echo "NCELL=${NCELL} CHK_STEP=${CHK_STEP} NODES=${NODES} RESTART_NODES=${RESTART_NODES}"
echo "RUN_DIR=${RUN_DIR}"
echo "quokka $(git -C "${QUOKKA_ROOT}" rev-parse --short HEAD)"

run reference "${NODES}" "${SIM}" "${common[@]}" checkpoint_format=amrex checkpoint_prefix=reference
run openpmd "${NODES}" "${SIM}" "${common[@]}" checkpoint_format=openpmd checkpoint_prefix=openpmd \
	max_timesteps="${CHK_STEP}"
# The step-0 checkpoints are not needed.
rm -rf "$(chk reference 0)" "$(chk openpmd 0).bp" "$(chk openpmd 0).yaml"
du -sh "$(chk reference "${CHK_STEP}")" "$(chk openpmd "${CHK_STEP}").bp"

run restart "${RESTART_NODES}" "${SIM}" "${common[@]}" checkpoint_format=amrex checkpoint_prefix=restarted \
	restartfile="$(chk openpmd "${CHK_STEP}")"
run compare "${NODES}" "${COMPARE}" reference="$(chk reference "${FINAL_STEP}")" \
	candidate="$(chk restarted "${FINAL_STEP}")" levels=1

if ((CONTROL)); then
	run native_restart "${RESTART_NODES}" "${SIM}" "${common[@]}" checkpoint_format=amrex \
		checkpoint_prefix=native_restarted restartfile="$(chk reference "${CHK_STEP}")"
	run native_compare "${NODES}" "${COMPARE}" reference="$(chk reference "${FINAL_STEP}")" \
		candidate="$(chk native_restarted "${FINAL_STEP}")" levels=1
fi

echo "PASS: openPMD restart at step ${CHK_STEP} reproduces step ${FINAL_STEP} exactly"
