#!/usr/bin/env bash

#SBATCH -A ast236
#SBATCH -J quokka_openpmd_restart
#SBATCH -o openpmd_restart_%x-%j.out
#SBATCH -t 01:00:00
#SBATCH -p batch
#SBATCH -N 64

# At-scale openPMD checkpoint/restart test and I/O bandwidth estimate
# (HydroBlast3D with tracers and one AMR level).
#
# openPMD runs are repeated for each ADIOS2 aggregation mode in AGGREGATION
# (openpmd.aggregation = off or on), written <mode> below.
# Write runs, on all nodes, 2K steps each:
#   reference       native AMReX checkpoints at steps 0, K and 2K
#   openpmd_<mode>  openPMD checkpoints at steps 0, K and 2K
#   plotfile_<mode> openPMD plotfiles at steps K and 2K (PLOTFILE=1)
# Read runs, on the last RESTART_NODES nodes (away from the writers' page cache):
#   read_openpmd_<mode> restart from that mode's openPMD checkpoint at K, no steps
#   read_native         restart from the native checkpoint at K, no steps
# Correctness, on the first RESTART_NODES nodes (a different rank count):
#   restart_<mode>  restart from that mode's openPMD checkpoint at K, native checkpoint at 2K
#   native_restart  the same from the native checkpoint (CONTROL=1)
#   compare         cell data (all levels) and tracers at 2K must match the reference bit for bit
#
# Effective bandwidth = bytes written or read / TinyProfiler time (inclusive, max over
# ranks) of the run's AMRSimulation::WriteCheckpointFile(), WritePlotFile() or
# ReadCheckpointFile() region. Each figure comes from a single run, so repeat the job
# to judge run-to-run variation.
#
# Build first (on a login node), from the repository root:
#   quokka config -d 3d-hip --source scripts/hpc_profiles/frontier.profile --root . \
#     -DQUOKKA_OPENPMD=ON -DADIOS2_DIR=<adios2 prefix>/lib64/cmake/adios2
#   quokka build -d 3d-hip --source scripts/hpc_profiles/frontier.profile --root . HydroBlast3D
#   ninja -C build/3d-hip OpenPMDCheckpoint
#
# Submit from the repository root:
#   sbatch scripts/slurm/frontier-openpmd-restart.submit
#
# Overrides (environment variables, e.g. `sbatch --export=ALL,NCELL=4096 -N 512 ...`):
#   NCELL          cells per dimension in x and y (default 2048; 2048^3 fits 64 nodes)
#   NCELL_Z        cells in z (default NCELL; set differently for a non-cubic domain)
#   MAX_LEVEL      finest AMR level (default 1; refines around the blast wave)
#   MAX_GRID_SIZE  maximum grid size and blocking factor (default 128)
#   CHK_STEP       K, the step of the checkpoint used for restart (default 10)
#   RESTART_NODES  nodes for the read and restart runs (default: half the allocation)
#   CONTROL        1 to also restart from the native checkpoint (default 1)
#   PLOTFILE       1 to also measure openPMD plotfile output (default 1)
#   AGGREGATION    openpmd.aggregation modes to compare (default "off on")
#   BUILD_DIR      build directory (default build/3d-hip)
#   RUN_DIR        output directory on Orion (default under the project scratch)
#   PROFILE        environment script to source (default scripts/hpc_profiles/frontier.profile)
#
# Each checkpoint is about 100 bytes per cell (cell data and tracers), so
# 2048^3 produces roughly 0.9 TB per checkpoint. Step-0, unused and compared
# checkpoints are deleted once measured; peak usage is about 6 TB.

QUOKKA_ROOT=${SLURM_SUBMIT_DIR:-$(pwd)}
cd "${QUOKKA_ROOT}" || exit 1
# Source before enabling strict mode: the module scripts reference unset variables.
# shellcheck source=/dev/null
. "${PROFILE:-scripts/hpc_profiles/frontier.profile}"
set -euo pipefail
export OMP_NUM_THREADS=1

NCELL=${NCELL:-2048}
NCELL_Z=${NCELL_Z:-${NCELL}}
MAX_LEVEL=${MAX_LEVEL:-1}
MAX_GRID_SIZE=${MAX_GRID_SIZE:-128}
CHK_STEP=${CHK_STEP:-10}
FINAL_STEP=$((2 * CHK_STEP))
NODES=${SLURM_JOB_NUM_NODES}
RESTART_NODES=${RESTART_NODES:-$(((NODES + 1) / 2))}
CONTROL=${CONTROL:-1}
PLOTFILE=${PLOTFILE:-1}
read -r -a AGGREGATION <<<"${AGGREGATION:-off on}"
BUILD_DIR=$(realpath -m "${BUILD_DIR:-build/3d-hip}")
RUN_DIR=${RUN_DIR:-/lustre/orion/${proj}/scratch/${USER}/quokka-openpmd-restart/${SLURM_JOB_ID}}

SIM=${BUILD_DIR}/src/problems/HydroBlast3D/HydroBlast3D
COMPARE=${BUILD_DIR}/src/problems/ParticleSchema/OpenPMDCheckpoint
for exe in "${SIM}" "${COMPARE}"; do
	[[ -x ${exe} ]] || {
		echo "missing executable: ${exe}" >&2
		exit 1
	}
done
if ((RESTART_NODES < 1 || RESTART_NODES > NODES)); then
	echo "RESTART_NODES=${RESTART_NODES} must be between 1 and ${NODES}" >&2
	exit 1
fi

mkdir -p "${RUN_DIR}"
cd "${RUN_DIR}"

chk() { printf '%s%07d' "$1" "$2"; }

# Total apparent size in bytes of the given files and directories.
bytes() {
	python3 -c 'import os, sys
total = 0
for path in sys.argv[1:]:
    if os.path.isdir(path):
        total += sum(os.path.getsize(os.path.join(root, name)) for root, _, names in os.walk(path) for name in names)
    else:
        total += os.path.getsize(path)
print(total)' "$@"
}

# The elapsed time (s) a run reports, and the inclusive max time (s) of a TinyProfiler region.
elapsed() { awk '/^elapsed time:/ { print $3 }' "$1.log"; }
region() { awk -v name="$2" '/Incl\. Min/ { incl = 1 } incl && $1 == name { print $5; exit }' "$1.log"; }

common=("${QUOKKA_ROOT}/inputs/HydroBlast3D.toml"
	"amr.n_cell=${NCELL} ${NCELL} ${NCELL_Z}" amr.max_level="${MAX_LEVEL}"
	amr.max_grid_size="${MAX_GRID_SIZE}" amr.blocking_factor="${MAX_GRID_SIZE}"
	do_tracers=1 quokka.slice_z.int=-1 blast_problem.check_solution=0 tiny_profiler.enabled=1)
no_output=(checkpoint_interval=-1 plotfile_interval=-1)

# Run one step of the test on $2 nodes, starting at node $3 of the allocation
# (default 0); output goes to <label>.log.
run() {
	local label=$1 nodes=$2 first=$3
	shift 3
	echo "=== ${label}: ${nodes} nodes from node ${first}, $((nodes * 8)) ranks"
	if ! srun -N "${nodes}" -n $((nodes * 8)) --relative="${first}" --ntasks-per-node=8 --cpus-per-task=7 --gpus-per-task=1 \
		--gpu-bind=closest "$@" >"${label}.log" 2>&1; then
		echo "${label} FAILED; see ${RUN_DIR}/${label}.log"
		tail -n 30 "${label}.log"
		exit 1
	fi
	local t
	t=$(elapsed "${label}")
	echo "${label} finished${t:+, elapsed ${t} s}"
}

# Record one bandwidth line: label, direction, bytes, run, TinyProfiler region.
summary=()
measure() {
	local label=$1 direction=$2 size=$3 log=$4 name=$5
	local line
	line=$(awk -v label="${label}" -v dir="${direction}" -v size="${size}" -v t="$(region "${log}" "${name}")" 'BEGIN {
		time = t == "" ? "n/a" : t
		bw = t > 0 ? sprintf("%.2f", size / t / 1e9) : "n/a"
		printf "%-26s %-5s %10.3f %10s %10s\n", label, dir, size / 1e9, time, bw
	}')
	summary+=("${line}")
}

echo "NCELL=${NCELL}x${NCELL}x${NCELL_Z} MAX_LEVEL=${MAX_LEVEL} CHK_STEP=${CHK_STEP} NODES=${NODES} RESTART_NODES=${RESTART_NODES}"
echo "RUN_DIR=${RUN_DIR}"
echo "quokka $(git -C "${QUOKKA_ROOT}" rev-parse --short HEAD)"

# Write runs.
steps=(max_timesteps="${FINAL_STEP}")
run reference "${NODES}" 0 "${SIM}" "${common[@]}" "${steps[@]}" checkpoint_interval="${CHK_STEP}" plotfile_interval=-1 \
	checkpoint_format=amrex checkpoint_prefix=reference
native_written=()
for step in 0 "${CHK_STEP}" "${FINAL_STEP}"; do
	native_written+=("$(chk reference "${step}")")
done
measure "native checkpoint" write "$(bytes "${native_written[@]}")" reference "AMRSimulation::WriteCheckpointFile()"
# Keep only the native checkpoints at K and 2K.
rm -rf "$(chk reference 0)"
for mode in "${AGGREGATION[@]}"; do
	prefix=openpmd_${mode}
	run "${prefix}" "${NODES}" 0 "${SIM}" "${common[@]}" "${steps[@]}" checkpoint_interval="${CHK_STEP}" plotfile_interval=-1 \
		checkpoint_format=openpmd checkpoint_prefix="${prefix}" openpmd.aggregation="${mode}"
	openpmd_written=()
	for step in 0 "${CHK_STEP}" "${FINAL_STEP}"; do
		openpmd_written+=("$(chk "${prefix}" "${step}").bp" "$(chk "${prefix}" "${step}").yaml")
	done
	measure "openPMD checkpoint (${mode})" write "$(bytes "${openpmd_written[@]}")" "${prefix}" "AMRSimulation::WriteCheckpointFile()"
	# Keep only the openPMD checkpoint at K.
	rm -rf "$(chk "${prefix}" 0).bp" "$(chk "${prefix}" 0).yaml" "$(chk "${prefix}" "${FINAL_STEP}").bp" \
		"$(chk "${prefix}" "${FINAL_STEP}").yaml"

	if ((PLOTFILE)); then
		run "plotfile_${mode}" "${NODES}" 0 "${SIM}" "${common[@]}" "${steps[@]}" checkpoint_interval=-1 \
			plotfile_interval="${CHK_STEP}" skip_initial_plotfile=1 openpmd.aggregation="${mode}"
		measure "openPMD plotfile (${mode})" write "$(bytes plt*.bp plt*.yaml)" "plotfile_${mode}" "AMRSimulation::WritePlotFile()"
		rm -rf plt*.bp plt*.yaml
	fi
done

# Read runs, on the last RESTART_NODES nodes.
read_first=$((NODES - RESTART_NODES))
for mode in "${AGGREGATION[@]}"; do
	prefix=openpmd_${mode}
	run "read_${prefix}" "${RESTART_NODES}" "${read_first}" "${SIM}" "${common[@]}" max_timesteps="${CHK_STEP}" "${no_output[@]}" \
		restartfile="$(chk "${prefix}" "${CHK_STEP}")"
	measure "openPMD checkpoint (${mode})" read "$(bytes "$(chk "${prefix}" "${CHK_STEP}").bp" "$(chk "${prefix}" "${CHK_STEP}").yaml")" \
		"read_${prefix}" "AMRSimulation::ReadCheckpointFile()"
done
run read_native "${RESTART_NODES}" "${read_first}" "${SIM}" "${common[@]}" max_timesteps="${CHK_STEP}" "${no_output[@]}" \
	restartfile="$(chk reference "${CHK_STEP}")"
measure "native checkpoint" read "$(bytes "$(chk reference "${CHK_STEP}")")" read_native "AMRSimulation::ReadCheckpointFile()"

# Correctness: restarts on a different rank count must reproduce step 2K exactly.
levels=$((MAX_LEVEL + 1))
restart_common=("${SIM}" "${common[@]}" "${steps[@]}" checkpoint_interval="${CHK_STEP}" plotfile_interval=-1 checkpoint_format=amrex)
for mode in "${AGGREGATION[@]}"; do
	run "restart_${mode}" "${RESTART_NODES}" 0 "${restart_common[@]}" checkpoint_prefix="restarted_${mode}" \
		restartfile="$(chk "openpmd_${mode}" "${CHK_STEP}")"
	run "compare_${mode}" "${NODES}" 0 "${COMPARE}" reference="$(chk reference "${FINAL_STEP}")" \
		candidate="$(chk "restarted_${mode}" "${FINAL_STEP}")" levels="${levels}"
	rm -rf "$(chk "restarted_${mode}" "${FINAL_STEP}")"
done
if ((CONTROL)); then
	run native_restart "${RESTART_NODES}" 0 "${restart_common[@]}" checkpoint_prefix=native_restarted \
		restartfile="$(chk reference "${CHK_STEP}")"
	run native_compare "${NODES}" 0 "${COMPARE}" reference="$(chk reference "${FINAL_STEP}")" \
		candidate="$(chk native_restarted "${FINAL_STEP}")" levels="${levels}"
fi

echo
echo "Effective I/O bandwidth (GB = 1e9 bytes; TinyProfiler times in s; write runs on ${NODES} nodes, reads on ${RESTART_NODES})"
printf "%-26s %-5s %10s %10s %10s\n" output dir GB time GB/s
for line in "${summary[@]}"; do
	echo "${line}"
done
echo "(time = inclusive max time of the run's WriteCheckpointFile, WritePlotFile or ReadCheckpointFile region)"
echo
echo "PASS: openPMD restarts at step ${CHK_STEP} (aggregation: ${AGGREGATION[*]}) reproduce step ${FINAL_STEP} exactly"
