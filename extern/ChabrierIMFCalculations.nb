Cell[TextData[{
 "Calculate fraction of mass in stars more massive than 9 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "\[PermutationProduct]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fad422f-1246-4d51-9b48-a7ff1ad5e607"],
 ":"
}], "Text",
 CellChangeTimes->{{3.955133704807489*^9, 3.955133737075391*^9}, {
  3.95513441942552*^9, 
  3.955134436579412*^9}},ExpressionUUID->"29bbedec-b015-4478-8f60-\
0bf93c6aeb5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mhigh", "=", "9"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"\"\<High\>\"", " ", "mass", " ", "value", " ", "in", " ", 
    RowBox[{"Msun", " ", "--"}], " ", "stars", " ", "above", " ", "this", " ",
     "mass", " ", "can", " ", "have", " ", "SNe"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"fhigh", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"dNdlog10M", "[", "M", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"M", ",", "Mhigh", ",", "Mmax"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.955133729192223*^9, 3.9551338042943077`*^9}, {
  3.955134134257206*^9, 3.9551341423502197`*^9}, {3.955134351328882*^9, 
  3.955134355313905*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"bb87fb95-40e8-4ab7-a5bd-4d15d5fad030"],

Cell[BoxData["0.20549466073679384`"], "Output",
 CellChangeTimes->{
  3.955134152524395*^9, {3.955134346938937*^9, 3.955134360972455*^9}, 
   3.955136771299161*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"346347f8-72ba-407d-aa2c-a70407ef99f3"]
}, Open  ]],

Cell[TextData[{
 "Now calculate the mean mass of star more massive than 9 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "\[PermutationProduct]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2979588a-5245-4b0a-abda-6c0270f465c2"],
 ". To do this calculation, recall that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "M0", "M1"], 
     RowBox[{
      FractionBox["dN", 
       RowBox[{"dlog", "(", "M", ")"}]], 
      RowBox[{"\[DifferentialD]", "logM"}]}]}], "\[Proportional]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "46decaf7-fcef-45e9-8a02-c2af5ae214ec"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "M0", "M1"], 
    RowBox[{
     FractionBox["1", "M"], 
     FractionBox["dN", 
      RowBox[{"dlog", "(", "M", ")"}]], 
     RowBox[{"\[DifferentialD]", "M"}]}]}], TraditionalForm]],ExpressionUUID->
  "e1aa55fc-42a5-496d-b906-82999ae4a1ea"],
 " is the ",
 StyleBox["number",
  FontSlant->"Italic"],
 " of stars from M0 to M1. Thus the quantity we want is "
}], "Text",
 CellChangeTimes->{{3.9551343688390093`*^9, 3.955134567280381*^9}, {
  3.955134663536233*^9, 
  3.955134670801219*^9}},ExpressionUUID->"19d865f5-b18c-4fd2-8536-\
893a6bbb4f24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MstarHighMean", "=", 
  FractionBox["fhigh", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"dNdlog10M", "[", "M", "]"}], "M"], ",", 
     RowBox[{"{", 
      RowBox[{"M", ",", "Mhigh", ",", "Mmax"}], "}"}]}], "]"}]]}]], "Input",
 CellChangeTimes->{{3.9551345731848507`*^9, 3.955134584463708*^9}, {
  3.955134629268033*^9, 3.95513465416078*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8be9fba0-654d-486d-a6bb-7c4ed2332a71"],

Cell[BoxData["21.339692601589096`"], "Output",
 CellChangeTimes->{3.955134663212434*^9, 3.955136775354932*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"2d8f8fb7-dbe4-48c2-9f44-c687623386fe"]
}, Open  ]]
},
