(* Beginning of Notebook Content *)
Notebook[{
Cell["Functional form of the Chabrier IMF:", "Text",
 CellChangeTimes->{{3.955132675529127*^9, 
  3.9551327021158543`*^9}},ExpressionUUID->"6e656099-c2d7-4c9d-9804-\
9d73cc24d7bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mmin", "=", "0.08"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Minimum", " ", "mass", " ", "in", " ", "units", " ", "of", " ", "Msun"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mmax", "=", "120"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Maximum", " ", "mass", " ", "in", " ", "units", " ", "of", " ", "Msun"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mbreak", "=", "1"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Break", " ", "mass", " ", "in", " ", "units", " ", "of", " ", "Msun"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mpeak", " ", "=", " ", "0.2"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Peak", " ", "mass", " ", "in", " ", "units", " ", "of", " ", "Msun"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]log10M", " ", "=", " ", "0.55"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Dispersion", " ", "in", " ", 
    SubscriptBox["log", "10"], "M"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", "=", 
    RowBox[{"-", "2.35"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"High", "-", 
    RowBox[{"mass", " ", "slope"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dNdlog10MNonNorm", "[", "M_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            FractionBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Log10", "[", "M", "]"}], "-", 
                RowBox[{"Log10", "[", "Mpeak", "]"}]}], ")"}], "2"], 
             RowBox[{"2", " ", 
              SuperscriptBox["\[Sigma]log10M", "2"]}]]}], "]"}], ",", 
          RowBox[{
           RowBox[{"Mmin", "<=", "M"}], " ", "&&", " ", 
           RowBox[{"M", "<", "Mbreak"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Log10", "[", "Mbreak", "]"}], "-", 
                 RowBox[{"Log10", "[", "Mpeak", "]"}]}], ")"}], "2"], 
              RowBox[{"2", " ", 
               SuperscriptBox["\[Sigma]log10M", "2"]}]]}], "]"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["M", "Mbreak"], ")"}], 
            RowBox[{"\[CapitalGamma]", "+", "1"}]]}], ",", 
          RowBox[{
           RowBox[{"Mbreak", "<=", "M"}], " ", "&&", " ", 
           RowBox[{"M", "<", "Mmax"}]}]}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Chabrier", " ", 
    RowBox[{"IMF", " ", "--"}], " ", "note", " ", "that", " ", "this", " ", 
    "is", " ", "NOT", " ", "properly", " ", "normalized"}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.955132705820002*^9, 3.955132737458521*^9}, {
  3.955132924805416*^9, 3.9551332964663553`*^9}, {3.955133352454159*^9, 
  3.955133389649767*^9}, {3.95513357032577*^9, 3.9551335715226297`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a34fe698-e541-45e7-b74b-d49c599c0289"],

Cell[TextData[{
 "Now compute the normalization. To understand this step, recall that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "M0", "M1"], 
    RowBox[{
     FractionBox["dN", 
      RowBox[{"dlog", "(", "M", ")"}]], 
     RowBox[{"\[DifferentialD]", "M"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7db1ed31-a233-43fa-8eac-f707008a98bd"],
 " is the ",
 StyleBox["mass",
  FontSlant->"Italic"],
 " in stars from M0 to M1, not the number of stars, since dN/dlog(M) \
\[Proportional] M dN/dM. Thus if we normalize such that",
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
    RowBox[{
     FractionBox["dN", 
      RowBox[{"dlog", "(", "M", ")"}]], 
     RowBox[{"\[DifferentialD]", "M"}]}]}], TraditionalForm]],ExpressionUUID->
  "f5462fb8-879a-49b3-bd45-d5074e865346"],
 " = 1, we can interpret ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "M0", "M1"], 
    RowBox[{
     FractionBox["dN", 
      RowBox[{"dlog", "(", "M", ")"}]], 
     RowBox[{"\[DifferentialD]", "M"}]}]}], TraditionalForm]],ExpressionUUID->
  "82c75313-a17e-414c-a276-0f48b83d5062"],
 " as the fraction of the stellar mass that lies in some mass interval \
(M0,M1)."
}], "Text",
 CellChangeTimes->{{3.955133835343246*^9, 
  3.955134122864401*^9}},ExpressionUUID->"a48c5443-d17d-4426-8766-\
57d5300e01a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"norm", "=", 
    RowBox[{"1", "/", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"dNdlog10MNonNorm", "[", "M", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"M", ",", "Mmin", ",", "Mmax"}], "}"}]}], "]"}]}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", "Normalization", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dNdlog10M", "[", "M_", "]"}], "=", 
    RowBox[{"norm", " ", 
     RowBox[{"dNdlog10MNonNorm", "[", "M", "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Properly", " ", "normalized", " ", "Chabrier", " ", "IMF"}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.955133541239311*^9, 3.955133607107888*^9}, {
  3.9551343184203577`*^9, 3.955134321665886*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"7cc2d9e9-7b95-4237-aa78-7e7940ca45fa"],

Cell["Plot of the Chabrier IMF:", "Text",
 CellChangeTimes->{{3.955133425060296*^9, 
  3.9551334315557003`*^9}},ExpressionUUID->"3c4086b9-6e2b-40dd-9f03-\
fa87781d8df1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"dNdlog10M", "[", "M", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"M", ",", "Mmin", ",", "Mmax"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<log (M/\!\(\*SubscriptBox[\(M\), \(\[PermutationProduct]\)]\))\>\"",
       ",", "\"\<dN/dM\>\""}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.955133299204844*^9, 3.9551333385773478`*^9}, {
  3.9551334357662783`*^9, 3.955133449012917*^9}, {3.955133512661577*^9, 
  3.955133533861536*^9}, {3.9551336294146147`*^9, 3.955133690307517*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"60328e1a-46d0-4966-8398-ca1e2304da7c"],

