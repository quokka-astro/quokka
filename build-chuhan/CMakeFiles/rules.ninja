#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /Users/meow/.local/lib/python3.13/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/Users/meow/quokka -B/Users/meow/quokka/build-chuhan
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = /Users/meow/.local/lib/python3.13/site-packages/cmake/data/bin/cmake -P /Users/meow/quokka/build-chuhan/CMakeFiles/VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /Users/meow/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /Users/meow/.local/bin/ninja -t targets
  description = All primary targets available:

