# Test input file to verify skip_initial_plotfile functionality
# This file tests that the initial plotfile is correctly skipped when enabled

# Set domain geometry
geometry.is_periodic = 1 1 1
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0

# Set grid
amr.n_cell = 32 32 32
amr.max_level = 0

# Set timestep
cfl = 0.4
stop_time = 0.1
max_timesteps = 10

# Enable plotfile output but skip initial
plotfile_interval = 5
skip_initial_plotfile = 1

# Use a simple hydro problem for testing
hydro.reconstruction = plm
hydro.low_level_debugging_output = 0

# Initial conditions for a simple uniform state
density = 1.0
pressure = 1.0
vx = 0.0
vy = 0.0
vz = 0.0