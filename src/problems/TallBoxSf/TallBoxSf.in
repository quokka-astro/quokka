# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0       0.0       -6.036e+21
geometry.prob_hi     =  3.018e21  3.018e21   6.036e+21
quokka.bc = periodic periodic ext_dir

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1      # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 512
amr.max_level       = 0     # number of levels = max_level + 1
amr.max_grid_size   = 128   # at least 128 for GPUs
amr.blocking_factor_x = 128   # grid size must be divisible by this
amr.blocking_factor_y = 128
amr.blocking_factor_z = 64
amr.n_error_buf     = 0     # 0 cell buffer around tagged cells to avoid over-tagging
amr.grid_eff        = 0.0

radiation.iteration_tolerance = 1e-9
radiation.iteration_tolerance_rel = 1e-6

cfl = 0.3
do_reflux = 1
do_subcycle = 0


plottime_interval = 3.155760000e+14   # 1e7 yr
checkpointtime_interval = 6.311520000e+14 # 2e7 yr
sfh_time_interval = 3.155760000e+12   # 1e5 yr
stop_time     = 6.31152E15 # 200 Myr  
max_timesteps = 100000000
#restartfile = last_chk
particle_csv_interval = 16
suppress_output = 0
regrid_interval = -1
# be careful about Poisson supercycling
poisson_supercycle_interval = 2

particles.verbose = 0
particles.disable_SN_feedback = true
particles.split_particles_on_restart_refine = false

density_floor = 1.67e-28 #in g cm^-3
temperature_floor = 10.0 #K

particles.eps_ff = 0.01
particles.param1 = 3.155760000e+14 # 10 Myr
particles.param2 = 1.0
#problem.stars_file = ../inputs/ParticlesInTallBox.txt
problem.stars_file = ""
problem.IC_file = "../disk_solution_datatable_Sigma13-Z1.csv"
problem.rho01 = 4.320441e-24
problem.sigma1 = 7.0e5
problem.boost_velocity = 2.0e7 0.0 0.0 # 200 km/s in x-direction

cooling.enabled = 1
cooling.cooling_table_type = "resampled"
cooling.hdf5_data_file = "../CloudyData_UVB=HM2012_shielded_resampled_noPE.h5"
use_sfh_based_pe_heating = true
sfh_to_pe_heating_table = "../photoelectric_heating_from_sfh.csv"
#sfh_interval = 3
sf_area_kpc2 = 1.0 					# kpc^2

perturb.filename = "../zdrv.hdf5"
perturb.amplitude = 15e5 # 15 km/s

problem.refine_zmax = 3.018e21 1.509e21  # refine to lev=1 with 1 kpc and lev=2 with 0.5 kpc

tiny_profiler.enabled = 1

statistics_interval = 128

derived_vars = temperature c_s

quokka.diagnostics = slice_x slice_z proj

quokka.slice_x.type = DiagFramePlane
quokka.slice_x.file = slicex_plt
quokka.slice_x.normal = 0              # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_x.center = 1.509001e21
quokka.slice_x.time_int = 3.155760000e+13   # 1e6 yr
quokka.slice_x.interpolation = Linear
quokka.slice_x.field_names = gasDensity gasEnergy x-GasMomentum y-GasMomentum z-GasMomentum temperature c_s
quokka.slice_x.particles = StochasticStellarPop_particles # List of particle types to include in output (default to none)

quokka.slice_z.type = DiagFramePlane
quokka.slice_z.file = slicez_plt
quokka.slice_z.normal = 2              # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_z.center = 1.0e12        # Domain center in the normal direction
quokka.slice_z.time_int = 3.155760000e+13   # 1e6 yr
quokka.slice_z.interpolation = Linear
quokka.slice_z.field_names = gasDensity gasEnergy x-GasMomentum y-GasMomentum z-GasMomentum temperature c_s
quokka.slice_z.particles = StochasticStellarPop_particles # List of particle types to include in output (default to none)

quokka.proj.type = ProjectionPlot   # Projection plot diagnostic
quokka.proj.file = proj_plt         # Output file prefix (must end in "plt")
quokka.proj.time_int = 3.155760000e+13   # 1e6 yr
quokka.proj.dirs = x                # Projection directions (x, y, z)
quokka.proj.particles = StochasticStellarPop_particles # List of particle types to include in output (default to none)

