@namespace: network

# Recombination switch
recombination_switch                    int        1

# Recombination is temperature dependent
recombination_temperature_dependent     int        1

# Collisional ionization switch
collisional_ionization_switch           int        1

# Heating/Cooling switch
energy_switch                           int        1

# Photoionization heating
photoheating_switch                     int        1

# Recombination cooling
recombination_cooling_switch            int        1

# Ion FF cooling
ion_ff_cooling_switch                   int        1

# ISM metallicity in solar units, Z' = Z / Z_sun
ism_metallicity                         real       1.0

# Cosmic-ray ionization rate of HI [s^-1]
cr_ionization_rate_HI                   real       1.78e-18

# Ly-alpha cooling
lya_cooling_switch                      int        1

# Nebular metal-line cooling
nebular_cooling_switch                  int        1

# C II and O I fine-structure cooling
fine_structure_cooling_switch           int        1

# Grain recombination cooling
grain_recombination_cooling_switch      int        1

# Photoelectric heating
pe_heating_switch                       int        1

# Cosmic-ray heating
cr_heating_switch                       int        1

# Gray dust opacity to ionizing radiation [cm^2/g], only used when
# DUST_CHEMICAL_BAND_ABSORPTION is defined.
dust_kappa                              real       0.0
