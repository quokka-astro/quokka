# Test for particle deposition utilities
# This test verifies that particle properties can be correctly deposited onto the grid

max_timesteps = 10
stop_time = 0.1
quokka.bc = periodic periodic periodic

geometry.is_periodic = 1 1 1
geometry.coord_sys = 0  # Cartesian
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0

amr.n_cell = 64 64 64
amr.max_level = 0
amr.max_grid_size = 32 32 32
amr.blocking_factor = 8 8 8

hydro.cfl = 0.4
hydro.reconstruction_order = 2
hydro.use_dual_energy = 0

# Particle parameters
particles.verbose = 1

# Particle deposition diagnostic
diag.particle_deposition.type = DiagParticleDeposition
diag.particle_deposition.int = 5
diag.particle_deposition.particle_types = CIC
diag.particle_deposition.deposit_fields = mass
diag.particle_deposition.output_format = plotfile

# I/O
amr.plot_int = 10
amr.plot_file = particle_deposition_
derived_vars = particle_mass_density
amr.check_int = -1

# Verbosity
amr.v = 1
amr.grid_log = grdlog
amr.data_log = datalog
