# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -3.949667304e+20 -3.949667304e+20 -3.949667304e+20
geometry.prob_hi     =  3.949667304e+20 3.949667304e+20 3.949667304e+20
quokka.bc = periodic periodic periodic

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 32 32 32
amr.max_level       = 1     # number of levels = max_level + 1
amr.blocking_factor = 32    # grid size must be divisible by this
amr.max_grid_size   = 32    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7   # default

do_reflux = 1
do_subcycle = 0
do_tracers = 0      # turn on tracer particles

hydro.artificial_viscosity_coefficient = 0.1

cooling.enabled = 1
cooling.cooling_table_type = "resampled"
cooling.hdf5_data_file = "../extern/cooling/CloudyData_UVB=HM2012_resampled.h5"
problem.SN_particles_file = "../inputs/SN.txt"
problem.refine_half_domain = false

problem.n_amb = 0.1
problem.T_amb = 5.80e3
problem.t_stop = 3.0e5
particles.SN_scheme = SN_thermal_or_thermal_momentum
particles.verbose = 1

max_timesteps = 100
initial_dt = 3.15576e4
plotfile_interval = -1
checkpoint_interval = -1

#temperature_floor = 10
density_floor = 1e-28
signal_speed_abort = 4e8

suppress_output = 0
tiny_profiler.enabled = 1

