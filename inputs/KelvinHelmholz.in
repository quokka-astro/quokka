# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0 
geometry.prob_hi     =  1.0  1.0  1.0
quokka.bc = periodic periodic periodic

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 2048 2048 8
amr.max_level       = 4     # number of levels = max_level + 1
amr.blocking_factor = 128   # grid size must be divisible by this
amr.max_grid_size   = 128
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7   # default

do_reflux = 1
do_subcycle = 1
statistics_interval = 10

# *****************************************************************
# Kelvin-Helmholtz problem parameters
# *****************************************************************
kelvin_helmholtz.rho0 = 1.0
kelvin_helmholtz.P0 = 1.0
kelvin_helmholtz.shear_thickness = 0.0009765625  # 2 * (1.0 / 2048)
kelvin_helmholtz.perturb_amplitude = 0.01
kelvin_helmholtz.boost_factor = 100.0  # V0 = boost_factor * Cs
