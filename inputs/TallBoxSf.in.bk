# *****************************************************************
# Problem size and geometry
# *****************************************************************
# 1x1x8 kpc
geometry.prob_lo     =  0.0       0.0       -1.2072e22
geometry.prob_hi     =  3.018e21  3.018e21   1.2072e22
quokka.bc = periodic periodic ext_dir

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1      # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 1024
amr.max_level       = 0     # number of levels = max_level + 1
amr.max_grid_size   = 128   # at least 128 for GPUs
amr.blocking_factor = 64   # grid size must be divisible by this
amr.n_error_buf     = 0     # 0 cell buffer around tagged cells to avoid over-tagging
amr.grid_eff        = 0.0

cfl = 0.3
do_reflux = 1
do_subcycle = 0

sfh_time_interval = 3.155760000e+12   # 1e5 yr
stop_time     = 6.31152e14 # 20 Myr  
max_timesteps = 2000
#plottime_interval = 3.155760000e+14   # 1e7 yr
particle_csv_interval = 16
suppress_output = 0
regrid_interval = -1
# be careful about Poisson supercycling
poisson_supercycle_interval = 2

particles.verbose = 0
particles.disable_SN_feedback = false
particles.split_particles_on_restart_refine = false

density_floor = 1.67e-28 #in g cm^-3
temperature_floor = 10.0 #K

particles.eps_ff = 0.01
particles.param1 = 3.155760000e+14 # 10 Myr
particles.param2 = 1.0
#problem.stars_file = ../inputs/ParticlesInTallBox.txt
problem.stars_file = ""
problem.IC_file = ../extern/problems/TallBoxSf/disk_solution_datatable_Sigma13-Z1.csv
problem.rho01 = 4.320441e-24
problem.sigma1 = 7.0e5
problem.boost_velocity = 0.0 0.0 0.0 # 0 km/s in x-direction

cooling.enabled = 1
cooling.cooling_table_type = "resampled"
cooling.hdf5_data_file = "../extern/cooling/CloudyData_UVB=HM2012_shielded_resampled_noPE.h5"
use_sfh_based_pe_heating = true
sfh_to_pe_heating_table = "../extern/cooling/photoelectric_heating_from_sfh.csv"
#sfh_interval = 3
sf_area_kpc2 = 1.0 					# kpc^2

perturb.filename = "zdrv.hdf5"
perturb.amplitude = 7e5 # 7 km/s

problem.refine_zmax = 3.018e21 1.509e21  # refine to lev=1 with 1 kpc and lev=2 with 0.5 kpc

tiny_profiler.enabled = 1

statistics_interval = 128

derived_vars = temperature c_s


quokka.diagnostics = slice_x
quokka.slice_x.type = DiagFramePlane
quokka.slice_x.file = slicex_plt
quokka.slice_x.normal = 0              # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_x.center = 1.509001e21
quokka.slice_x.time_int = 3.155760000e+13   # 1e6 yr
quokka.slice_x.interpolation = Linear
quokka.slice_x.field_names = gasDensity gasEnergy x-GasMomentum y-GasMomentum z-GasMomentum
quokka.slice_x.particles = StochasticStellarPop_particles # List of particle types to include in output (default to none)

