# *****************************************************************
# Problem size and geometry
# *****************************************************************
# Box size is [-600 kpc, 600 kpc]^3
geometry.prob_lo     =  -1.8514065526075864e24 -1.8514065526075864e24 -1.8514065526075864e24
geometry.prob_hi     =   1.8514065526075864e24  1.8514065526075864e24  1.8514065526075864e24
geometry.is_periodic =   0    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128
amr.max_level       = 5
amr.blocking_factor = 32
amr.max_grid_size   = 128
amr.n_error_buf     = 3     # REQUIRED for correct grid generation
amr.grid_eff        = 0.7
regrid_interval     = -1    # static refinement only (do not regrid)

do_reflux = 1
do_subcycle = 0
do_tracers = 0
poisson_supercycle_interval = 10

print_cycle_timing = 1
max_walltime = 1:00:00

cfl = 0.3
init_shrink = 0.01	# shrink first timestep by a factor of 100
stop_time = 1.26e16     # 400 Myr
dt_cutoff = 1.0e-12	# abort if the timestep is less than time*dt_cutoff
max_timesteps = 1e7

# MHD parameters
hydro.artificial_viscosity_coefficient = 0.1
hydro.reconstruction_order = 2
hydro.plm_limiter = minmod
mhd.emf_reconstruction_order = 2
mhd.plm_limiter = minmod
mhd.emf_compute_scheme = Quokka2026
mhd.emf_averaging_scheme = LondrilloDelZanna2004

mhd.project_initial_b_field = true
mhd.update_initial_b_energy = true

cooling.enabled = 1
cooling.read_tables_even_if_disabled = 1
cooling.cooling_table_type = resampled
cooling.hdf5_data_file = "./CloudyData_UVB=HM2012_resampled.h5"
temperature_floor = 100
density_floor = 1e-28
density_floor_expr = "x1=x*1.0e-22; y1=y*1.0e-22; z1=z*1.0e-22; r2=x1*x1+y1*y1+z1*z1; rb2=3.08567758*3.08567758; base_density_floor * (rb2 / max(r2, rb2))"

checkpoint_interval = 10000
plotfile_interval = 10000
statistics_interval = 250
derived_vars = temperature pressure entropy gpot radius_sph bfield_strength radial_velocity circular_velocity

# *****************************************************************
# In-situ histogram diagnostics (radial profiles)
# *****************************************************************
quokka.diagnostics = slice_x slice_z volrender hist_rho hist_temp hist_bmag hist_vrad hist_press hist_entropy hist_rho_temp

## in-situ slice output
quokka.slice_x.type = DiagFramePlane         # Diagnostic type
quokka.slice_x.file = slices/x/plt           # Output file prefix (must end in "plt")
quokka.slice_x.normal = 0                    # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_x.center = 0.0                  # Coordinate in the normal direction
quokka.slice_x.int    = 250                  # Output cadence (in number of coarse steps)
quokka.slice_x.interpolation = Linear        # (Optional, default is Linear) Interpolation type: Linear or Quadratic
quokka.slice_x.field_names = gasDensity x-GasMomentum y-GasMomentum z-GasMomentum gasEnergy gasInternalEnergy x-BField y-BField z-BField temperature pressure entropy gpot bfield_strength radial_velocity circular_velocity

quokka.slice_z.type = DiagFramePlane         # Diagnostic type
quokka.slice_z.file = slices/z/plt           # Output file prefix (must end in "plt")
quokka.slice_z.normal = 2                    # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_z.center = 0.0                  # Coordinate in the normal direction
quokka.slice_z.int    = 250                  # Output cadence (in number of coarse steps)
quokka.slice_z.interpolation = Linear        # (Optional, default is Linear) Interpolation type: Linear or Quadratic
quokka.slice_z.field_names = gasDensity x-GasMomentum y-GasMomentum z-GasMomentum gasEnergy gasInternalEnergy x-BField y-BField z-BField temperature pressure entropy gpot bfield_strength radial_velocity circular_velocity

## in-situ volume rendering
quokka.volrender.type = VolumeRender
quokka.volrender.field = temperature
quokka.volrender.log_scale_input = 1
quokka.volrender.int = 10
quokka.volrender.width = 512
quokka.volrender.height = 512
quokka.volrender.output_ext = png
quokka.volrender.min_level = 4
quokka.volrender.max_level = 5
quokka.volrender.camera_up = 0 0 1
