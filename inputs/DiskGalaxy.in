quokka.hist_rho.type = DiagPDF
quokka.hist_rho.file = pdfs/RadiusDensity/PDF
quokka.hist_rho.int  = 250
quokka.hist_rho.weight_by = volume
quokka.hist_rho.var_names = radius_sph gasDensity  # radius_sph in kpc
quokka.hist_rho.radius_sph.nBins = 120
quokka.hist_rho.radius_sph.log_spaced_bins = 1
quokka.hist_rho.radius_sph.range = 1.0 500.0
quokka.hist_rho.gasDensity.nBins = 80
quokka.hist_rho.gasDensity.log_spaced_bins = 1
quokka.hist_rho.gasDensity.range = 1e-30 1e-20

quokka.hist_temp.type = DiagPDF
quokka.hist_temp.file = pdfs/RadiusTemperature/PDF
quokka.hist_temp.int  = 250
quokka.hist_temp.weight_by = volume
quokka.hist_temp.var_names = radius_sph temperature  # radius_sph in kpc, temperature in K
quokka.hist_temp.radius_sph.nBins = 120
quokka.hist_temp.radius_sph.log_spaced_bins = 1
quokka.hist_temp.radius_sph.range = 1.0 500.0
quokka.hist_temp.temperature.nBins = 160
quokka.hist_temp.temperature.log_spaced_bins = 1
quokka.hist_temp.temperature.range = 10.0 1e9

quokka.hist_bmag.type = DiagPDF
quokka.hist_bmag.file = pdfs/RadiusBField/PDF
quokka.hist_bmag.int  = 250
quokka.hist_bmag.weight_by = volume
quokka.hist_bmag.var_names = radius_sph bfield_strength  # radius_sph in kpc, bfield_strength in microgauss
quokka.hist_bmag.radius_sph.nBins = 120
quokka.hist_bmag.radius_sph.log_spaced_bins = 1
quokka.hist_bmag.radius_sph.range = 1.0 500.0
quokka.hist_bmag.bfield_strength.nBins = 80
quokka.hist_bmag.bfield_strength.log_spaced_bins = 1
quokka.hist_bmag.bfield_strength.range = 0.1 1000.0

quokka.hist_vrad.type = DiagPDF
quokka.hist_vrad.file = pdfs/RadiusRadialVelocity/PDF
quokka.hist_vrad.int  = 250
quokka.hist_vrad.weight_by = volume
quokka.hist_vrad.var_names = radius_sph radial_velocity  # radius_sph in kpc, radial_velocity in km/s
quokka.hist_vrad.radius_sph.nBins = 120
quokka.hist_vrad.radius_sph.log_spaced_bins = 1
quokka.hist_vrad.radius_sph.range = 1.0 500.0
quokka.hist_vrad.radial_velocity.nBins = 400
quokka.hist_vrad.radial_velocity.log_spaced_bins = 0
quokka.hist_vrad.radial_velocity.range = -1000.0 1000.0

quokka.hist_press.type = DiagPDF
quokka.hist_press.file = pdfs/RadiusPressure/PDF
quokka.hist_press.int  = 250
quokka.hist_press.weight_by = volume
quokka.hist_press.var_names = radius_sph pressure  # radius_sph in kpc, pressure in K cm^-3
quokka.hist_press.radius_sph.nBins = 120
quokka.hist_press.radius_sph.log_spaced_bins = 1
quokka.hist_press.radius_sph.range = 1.0 500.0
quokka.hist_press.pressure.nBins = 120
quokka.hist_press.pressure.log_spaced_bins = 1
quokka.hist_press.pressure.range = 10.0 1e5

quokka.hist_entropy.type = DiagPDF
quokka.hist_entropy.file = pdfs/RadiusEntropy/PDF
quokka.hist_entropy.int  = 250
quokka.hist_entropy.weight_by = volume
quokka.hist_entropy.var_names = radius_sph entropy  # radius_sph in kpc
quokka.hist_entropy.radius_sph.nBins = 120
quokka.hist_entropy.radius_sph.log_spaced_bins = 1
quokka.hist_entropy.radius_sph.range = 1.0 500.0
quokka.hist_entropy.entropy.nBins = 120
quokka.hist_entropy.entropy.log_spaced_bins = 1
quokka.hist_entropy.entropy.range = 1e-4 2e2

quokka.hist_rho_temp.type = DiagPDF
quokka.hist_rho_temp.file = pdfs/DensityTemperature/PDF
quokka.hist_rho_temp.int  = 250
quokka.hist_rho_temp.weight_by = mass
quokka.hist_rho_temp.var_names = gasDensity temperature
quokka.hist_rho_temp.gasDensity.nBins = 80
quokka.hist_rho_temp.gasDensity.log_spaced_bins = 1
quokka.hist_rho_temp.gasDensity.range = 1e-30 1e-20
quokka.hist_rho_temp.temperature.nBins = 160
quokka.hist_rho_temp.temperature.log_spaced_bins = 1
quokka.hist_rho_temp.temperature.range = 10.0 1e9

##
## Disk and halo parameters
##

disk_galaxy.vcirc_file    = "./vcirc_with_halo.csv"
disk_galaxy.particle_file = "./AgoraGalaxy_particles_LOW.txt"
disk_galaxy.refine_Rmax_kpc = 16.0          # kpc
disk_galaxy.refine_zmax_kpc = 4.0           # kpc

disk_galaxy.disk_gas_mass_Msun = 8.59322e9  # solar masses
disk_galaxy.disk_Rscale_kpc = 3.43218       # kpc
disk_galaxy.disk_zscale_kpc = 0.343218      # kpc
disk_galaxy.disk_temperature = 1.0e4        # K
disk_galaxy.disk_perturb_amplitude = 1.0    # dimensionless
disk_galaxy.disk_perturb_Rmax_kpc = 20.0    # kpc
disk_galaxy.magnetic_field_microgauss = 1.0 # B-field strength (microgauss)
