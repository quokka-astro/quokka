# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -3.949667304e+19 -3.949667304e+19 -3.949667304e+19
geometry.prob_hi     =  3.949667304e+19 3.949667304e+19 3.949667304e+19
quokka.bc = reflecting reflecting reflecting

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 32 32 32
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 16    # grid size must be divisible by this
amr.max_grid_size   = 16    # at least 128 for GPUs
amr.n_error_buf     = 2     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7   # default

do_reflux = 1
do_subcycle = 0
do_tracers = 0      # turn on tracer particles

particles.verbose = 1

initial_dt = 3.15576e12

tiny_profiler.enabled = 0

derived_vars = temperature c_s

quokka.diagnostics = plt slice_z slice_x part

quokka.plt.type = PlotFile         # pltfile for the whole box
quokka.plt.file = plt              # Output file prefix (default "plt", must end in "plt")
quokka.plt.time_int  = 2e13        # Output cadence (in time intervals). For this test, expected outputs are: 6, 9, 12, 15, 18
#quokka.plt.particles = # Default to all particle types
quokka.plt.field_names = gasDensity gasInternalEnergy temperature
quokka.plt.fc_dirs = x y

quokka.slice_z.type = DiagFramePlane         # Diagnostic type
quokka.slice_z.file = slicez_plt             # Output file prefix (must end in "plt")
quokka.slice_z.normal = 2                    # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_z.center = 1e10                 # Coordinate in the normal direction (cannot lie *exactly* on domain boundary)
quokka.slice_z.int    = 9                    # Output cadence (in number of coarse steps). Expected outputs: 9, 18, ...
# List of variables included in output. Omitting this will result in empty Cell_D files
quokka.slice_z.field_names = gasDensity gasInternalEnergy x-GasMomentum y-GasMomentum z-GasMomentum 

quokka.slice_x.type = DiagFramePlane         # Diagnostic type
quokka.slice_x.file = slicex_plt             # Output file prefix (must end in "plt")
quokka.slice_x.normal = 0                    # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slice_x.center = 1e10                 # Coordinate in the normal direction (cannot lie *exactly* on domain boundary)
quokka.slice_x.time_int    = 4e13            # Output cadence (in time intervals). For this test, expected outputs are: 9, 15
quokka.slice_x.particles = Sink_particles
quokka.slice_x.field_names = gasDensity gasInternalEnergy # List of variables included in output

quokka.part.type = ParticleTxt         # Diagnostic type
quokka.part.file = part_plt             # Output file prefix (must end in "plt")
#quokka.part.int = 18
quokka.part.time_int = 4e13
quokka.part.particles = Sink_particles
