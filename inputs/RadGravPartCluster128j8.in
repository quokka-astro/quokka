# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -1.6e20 -1.6e20 -1.6e20
geometry.prob_hi     =  1.6e20 1.6e20 1.6e20
geometry.is_periodic =  1    1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 64     # grid size must be divisible by this
amr.max_grid_size   = 64    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7

do_reflux = 1
do_subcycle = 0
suppress_output = 0

particles.verbose = 0
particles.disable_SN_feedback = true
particles.rad_table = ../inputs/lum_data_4groups.csv
particles.rad_table_output_spacing = fast_log

stop_time = 1.577880000e+15 # 50 Myr
max_timesteps = 10
particle_csv_interval = 10
checkpoint_interval = -1

tiny_profiler.enabled = 0

#problem.particles_filename = ../inputs/TestParticlesNoRad.txt
#problem.particles_filename = ../inputs/cluster_N50_r20.0_ng4.txt
problem.particles_filename = ../inputs/cluster_N500_r20.0_ng4.txt

radiation.iteration_tolerance = 1e-10
radiation.iteration_tolerance_rel = -1

quokka.diagnostics = slicex plt
quokka.slicex.type = DiagFramePlane         # Diagnostic type
quokka.slicex.file = slicex_plt             # Output file prefix (must end in "plt")
quokka.slicex.normal = 2                    # Plane normal (0 == x, 1 == y, 2 == z)
quokka.slicex.center = 1e10              # midplane, ~ 0
quokka.slicex.int    = 10                   # Output cadence (in number of coarse steps)
quokka.slicex.field_names = gasDensity gasInternalEnergy radEnergy-Group0 radEnergy-Group1 radEnergy-Group2 radEnergy-Group3

quokka.plt.type = PlotFile         # pltfile for the whole box
quokka.plt.file = plt              # Output file prefix (default "plt", must end in "plt")
quokka.plt.int  = 10                # Output cadence (in number of coarse steps)
quokka.plt.particles = StochasticStellarPop_particles

cooling.enabled = 1
cooling.read_tables_even_if_disabled = 1
cooling.cooling_table_type = resampled
cooling.hdf5_data_file = "../extern/cooling/CloudyData_UVB=HM2012_resampled.h5"
