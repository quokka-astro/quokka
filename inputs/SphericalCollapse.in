# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -0.6  -0.6 -0.6 
geometry.prob_hi     =  0.6  0.6  0.6
geometry.is_periodic =  1    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128
amr.max_level       = 1     # number of levels = max_level + 1
amr.blocking_factor = 32    # grid size must be divisible by this
amr.max_grid_size   = 64    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 1.0

hydro.reconstruction_order = 3  # PPM
cfl = 0.25
max_timesteps = 20
checkpoint_interval = -1
plotfile_interval = 10000
stop_time = 0.05

derived_vars = gpot

do_reflux = 1
do_subcycle = 0
do_tracers = 0          # turn on tracer particles

ascent_interval = -1
particle_csv_interval = -1

problem.num_particles = 1000000
problem.seed = 42123
problem.r_refine = 0.2

# Number of bits to remove from the significand. 20 is the default value. For production runs with large number of cells and timesteps, you have to increase this value to ensure bitwise reproducibility.
particles.reproducibility_roundoff_redundancy = 20 

amrex.init_snan = 1
