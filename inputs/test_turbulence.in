# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  1.0  1.0  1.0
geometry.is_periodic =  1    1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128
amr.max_level       = 1     # number of levels = max_level + 1
amr.blocking_factor = 64     # grid size must be divisible by this
amr.max_grid_size   = 128    # at least 128 for GPUs

do_reflux = 0
do_subcycle = 0

Turbulence.path_to_turb_settings = /home/anish/Programming/research/quokka/inputs/turbgen.par
