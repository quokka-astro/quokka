#*****************************************************************
# FewModesFT stochastic forcing test, 128^3 domain
#*****************************************************************

# Geometry
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 1.0
geometry.is_periodic = 1   1   1

# AMR / grid setup
amr.n_cell          = 128 128 128
amr.max_level       = 0
amr.max_grid_size   = 128
amr.blocking_factor = 32

# Timestep / output control
plotfile_interval   = 20000
checkpoint_interval = -1
max_timesteps       = 20000
stop_time           = 1.0
cfl                 = 0.3
statistics_interval = 100
stats_file          = turb_driving_stats.txt

# FewModes forcing parameters
fewmodesft.num_modes         = 10
fewmodesft.k_peak            = 2.0
fewmodesft.solenoidal_weight = 0.5
fewmodesft.t_corr            = 1.0
fewmodesft.random_seed       = 12345
fewmodesft.rho0              = 1.0
fewmodesft.p0                = 1.0
fewmodesft.force_amplitude   = 1.0
