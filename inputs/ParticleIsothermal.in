# *****************************************************************
# Problem size and geometry
# *****************************************************************
#geometry.prob_lo     = -2e16 -2e16 -2e16
#geometry.prob_hi     = 2e16 2e16 2e16
#geometry.prob_lo     = -4e16 -4e16 -4e16
#geometry.prob_hi     = 4e16 4e16 4e16
#geometry.prob_lo     = -8e16 -8e16 -8e16
#geometry.prob_hi     = 8e16 8e16 8e16
geometry.prob_lo     = -5e16 -5e16 -5e16
geometry.prob_hi     = 5e16 5e16 5e16
geometry.is_periodic =  0    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 320 320 320
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 64    # grid size must be divisible by this
amr.max_grid_size   = 128    # at least 128 for GPUs
amr.n_error_buf     = 0     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.0   # default

do_reflux = 1
do_subcycle = 0

plotfile_interval = -1
checkpoint_interval = -1

problem.sink_file = "sink.txt"
problem.t_end = 1.2e12
max_timesteps = 0

tiny_profiler.enabled = 0

# quokka.diagnostics = slice_z
# quokka.slice_z.type = DiagFramePlane         # Diagnostic type
# quokka.slice_z.file = slicez_plt             # Output file prefix (must end in "plt")
# quokka.slice_z.normal = 2                    # Plane normal (0 == x, 1 == y, 2 == z)
# quokka.slice_z.center = 1e16                # Coordinate in the normal direction (cannot lie *exactly* on domain boundary)
# quokka.slice_z.int    = 32                   # Output cadence (in number of coarse steps)
# quokka.slice_z.interpolation = Linear        # (Optional, default is Linear) Interpolation type: Linear or Quadratic
# quokka.slice_z.field_names = gasDensity gasInternalEnergy x-GasMomentum y-GasMomentum z-GasMomentum # List of variables included in output
