# *****************************************************************
# Problem size and geometry
# *****************************************************************
# box size: (-7.7696 pc, 7.7696 pc)
geometry.prob_lo     = -4.795037710e+16 -4.795037710e+16 -4.795037710e+16
geometry.prob_hi     = 4.795037710e+16 4.795037710e+16 4.795037710e+16
geometry.is_periodic =  0    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 64    # grid size must be divisible by this
amr.max_grid_size   = 64    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7   # default

do_reflux = 1
do_subcycle = 0

stop_time = 3.0e15

plotfile_interval = 32
checkpoint_interval = 32
problem.star_mass = 0.005
max_timesteps = 8
problem.turnon_fextract = false
problem.uniform_density = 1.0e-25
problem.sink_file = "../inputs/sink_moving.txt"

particles.disable_particle_drift = false

#restartfile = last_chk

tiny_profiler.enabled = 0