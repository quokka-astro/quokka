# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0 
geometry.prob_hi     =  3.086e19  3.086e19  3.086e19  # 10 x 10 x 10 pc
quokka.bc = periodic periodic periodic

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v               = 1     # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 64 64 64
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 32     # grid size must be divisible by this
amr.max_grid_size   = 64

regrid_interval = 2
problem.refine_threshold = 0.1
do_reflux = 1
do_subcycle = 0

cfl = 0.3
hydro.reconstruction_order = 3
derived_vars = temperature

plotfile_interval = 3
checkpoint_interval = 3
max_timesteps = 6
stop_time = 3.154e15       # 1e6 yr

#constant_dt = 3.154e7

cooling.enabled = 1
cooling.read_tables_even_if_disabled = 1
cooling.cooling_table_type = resampled
cooling.hdf5_data_file = "../extern/cooling/CloudyData_UVB=HM2012_resampled.h5"

particles.SN_scheme = SN_thermal_only

problem.boost_velocity = 0.0 0.0 0.0

tiny_profiler.enabled = 0

quokka.diagnostics = proj
quokka.proj.type = ProjectionPlot   # Projection plot diagnostic
quokka.proj.file = proj_plt         # Output file prefix (must end in "plt")
quokka.proj.int  = 3                # Output cadence (in number of coarse steps)
quokka.proj.dirs = z                # Projection directions (x, y, z)
quokka.proj.particles = StochasticStellarPop_particles # List of particle types to include in output (default to none)