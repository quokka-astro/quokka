# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0       0.0       -6.036e+21
geometry.prob_hi     =  3.018e21  3.018e21   6.036e+21
quokka.bc = periodic periodic ext_dir

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1      # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 512
amr.max_level       = 1     # number of levels = max_level + 1
amr.max_grid_size   = 128   # at least 128 for GPUs
amr.blocking_factor = 32   # grid size must be divisible by this
amr.n_error_buf     = 0     # need 0 to enforce exact refinement boundaries
amr.grid_eff        = 0.0

do_reflux = 1
do_subcycle = 0
stop_time     = 9.462e+15
plotfile_interval = 128
particle_csv_interval = -1
suppress_output = 1
regrid_interval = -1
#poisson_supercycle_interval = 4

max_timesteps = 32
checkpoint_interval = -1
#restartfile = last_chk

particles.verbose = 1
particles.disable_SN_feedback = false
#particles.rad_table = /software/projects/pawsey0807/chongchong/setonix/quokka/extern/problems/TallBoxSf/lum_data_4groups.csv
#particles.rad_table_output_spacing = fast_log
particles.split_particles_on_restart_refine = false

density_floor = 1.67e-28 #in g cm^-3
temperature_floor = 10.0 #K

particles.eps_ff = 0.01
problem.stars_file = "" # no initial particles
problem.IC_file = /software/projects/pawsey0807/chongchong/setonix/quokka/extern/problems/TallBoxSf/disk_solution_datatable_Sigma13-Z1.csv
problem.rho01 = 4.320441e-24
problem.sigma1 = 7.0e5

# MHD
problem.magnetic_field_microgauss = 1.0 # uniform B-field strength (microgauss)
#hydro.artificial_viscosity_coefficient = 0.1
hydro.reconstruction_order = 2
hydro.plm_limiter = minmod
mhd.emf_reconstruction_order = 2
mhd.plm_limiter = minmod
mhd.emf_compute_scheme = Quokka2026
mhd.emf_averaging_scheme = LondrilloDelZanna2004



cooling.enabled = 1
cooling.cooling_table_type = "resampled"
cooling.hdf5_data_file = "/software/projects/pawsey0807/chongchong/setonix/quokka/extern/cooling/CloudyData_UVB=HM2012_shielded_resampled_noPE.h5"

use_sfh_based_pe_heating = true
sfh_to_pe_heating_table = "/software/projects/pawsey0807/chongchong/setonix/quokka/extern/cooling/photoelectric_heating_from_sfh.csv"
#sfh_interval = 3
sfh_time_interval = 3.15576e+13 # =1 Myr
sf_area_kpc2 = 1.0 					# kpc^2

perturb.filename = "/software/projects/pawsey0807/chongchong/setonix/quokka/tests/zdrv.hdf5"
#perturb.use_superresolution = 0
perturb.amplitude = 7e5 # 7 km/s

problem.refine_zmax = 3.018e21 1.509e21  # refine to lev=1 with 1 kpc and lev=2 with 0.5 kpc

tiny_profiler.enabled = 0

statistics_interval = 128

derived_vars = temperature c_s

