# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0 
geometry.prob_hi     =  0.01575  0.001575  1.0
geometry.is_periodic =  0    1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 256 8 8
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor_x = 128     # grid size must be divisible by this
amr.blocking_factor_y = 8
amr.blocking_factor_z = 8
amr.max_grid_size = 256

do_reflux = 0
do_subcycle = 0

plotfile_interval = 10000000
hydro.reconstruction_order = 5  # extrema-preserving xPPM
