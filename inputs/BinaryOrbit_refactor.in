# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -2.5e13 -2.5e13 -2.5e13
geometry.prob_hi     =   2.5e13  2.5e13  2.5e13
quokka.bc = periodic periodic periodic

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 64 64 64
amr.max_level       = 1     # number of levels = max_level + 1
amr.blocking_factor = 8    # grid size must be divisible by this
amr.max_grid_size   = 8    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 0.7

do_reflux = 1
do_subcycle = 0

ascent_interval = -1

tiny_profiler.enabled = 0

cfl = 0.3
stop_time = 5.0e7   # s
checkpoint_interval = 20
max_timesteps = 40
plotfile_interval = -1
restartfile = chk00020

particles.split_particles_on_restart_refine = false
