# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -2.03125 -2.03125 -2.03125
geometry.prob_hi     =  1.96875  1.96875  1.96875
geometry.is_periodic =  0    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 64 64 64
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 32     # grid size must be divisible by this
amr.max_grid_size   = 32    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 1.0

do_reflux = 0
do_subcycle = 0
suppress_output = 0

stop_time = 5.0
plotfile_interval = -1
checkpoint_interval = -1

#particle_creator_param1 = 0.001 # create particles at this time, which is step 1
#particle_creator_param2 = 0.012 # create particles at this time, which is step 3

particle_creator_param1 = 0.007 # create particles at this time, which is step 1
particle_creator_param2 = 1. # create particles at this time, which is step 3

max_timesteps = 2
