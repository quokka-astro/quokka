# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  -2. -2. -2.
geometry.prob_hi     =  2.  2.  2.
geometry.is_periodic =  0    0    0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 16 16 16
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 16     # grid size must be divisible by this
amr.max_grid_size   = 16    # at least 128 for GPUs
amr.n_error_buf     = 3     # minimum 3 cell buffer around tagged cells
amr.grid_eff        = 1.0

do_reflux = 0
do_subcycle = 0
suppress_output = 0

cfl = 0.3
do_cic_particles = 1    # turns on CIC particles
stop_time = 0.5
#plottime_interval = 0.1
plot_interval = 1000000
checkpointtime_interval = 100000
max_timesteps = 100000
