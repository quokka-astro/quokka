# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0	0.0	0.0 
geometry.prob_hi     =  1.0e20  1.0e20  1.0e20
geometry.is_periodic =  0    	0	0

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 0       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 4 4 4
amr.max_level       = 0     # number of levels = max_level + 1
amr.blocking_factor = 4     # grid size must be divisible by this

do_reflux = 0
do_subcycle = 0
suppress_output = 0

# *****************************************************************
# Cooling parameters
# *****************************************************************
cooling.enabled = 1
cooling.cooling_table_type = resampled
cooling.hdf5_data_file = "../extern/cooling/CloudyData_UVB=HM2012_resampled.h5"

# *****************************************************************
# Reference solution comparison (optional)
# *****************************************************************
# resampled_cooling_test.reference_solution_file = path/to/reference_solution.csv